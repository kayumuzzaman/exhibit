{
  "name": "payloadra",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "screenshots": "tsx scripts/screenshots.mjs",
    "audit:package": "node scripts/audit-package.mjs .output/chrome-mv3",
    "audit:dependencies": "pnpm audit --audit-level high",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test:coverage && pnpm audit:package && pnpm audit:dependencies && pnpm test:e2e",
    "release:artifact": "pnpm verify && pnpm zip"
  },
  "engines": {
    "node": "^22.13.0 || >=24",
    "pnpm": ">=10"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.1",
      "next>postcss": "^8.5.18",
      "next>sharp": "-"
    }
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.2.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.0.9",
    "@wxt-dev/module-react": "^1.2.2",
    "axe-core": "^4.12.1",
    "eslint": "^10.8.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "next": "^16.2.12",
    "playwright": "^1.57.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "tsx": "4.23.1",
    "vite": "^8.1.5",
    "vitest": "^4.0.9",
    "wxt": "^0.21.2"
  }
}
